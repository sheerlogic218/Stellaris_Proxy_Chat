# Copy to deploy/firewall.env if you need to change anything; the defaults suit most homes.
# Must match TS_OUT_SUBNET and BOT_OUT_SUBNET in deploy/.env.
TS_OUT_SUBNET="172.30.1.0/24"
BOT_OUT_SUBNET="172.30.2.0/24"
# Every private, link-local and Tailscale range is already blocked. Add any other
# ranges your network uses that the containers must not reach (space-separated),
# e.g. a public block your ISP routes to your LAN.
EXTRA_BLOCKED=""
