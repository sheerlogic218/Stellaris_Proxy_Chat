# Copy to deploy/.env and fill in. docker compose reads it from this folder.
# Values starting with CHANGE_ME must be set (see docs/DEPLOYMENT_PLACEHOLDERS.md).

# Base images, pinned by digest so a rebuild can't silently pull something else.
# Find a digest with: docker pull python:3.14-slim && docker inspect --format '{{index .RepoDigests 0}}' python:3.14-slim
PYTHON_IMAGE=python:3.14-slim@sha256:CHANGE_ME_PYTHON_DIGEST
TS_IMAGE=tailscale/tailscale:stable@sha256:CHANGE_ME_TAILSCALE_DIGEST

# The tailnet machine name: the public address becomes https://<this>.<tailnet>.ts.net
TS_HOSTNAME=proxychat

# Container networks. Must not overlap your LAN or other Docker networks; the
# firewall script (firewall.env) must use the same two *_OUT ranges.
EDGE_SUBNET=172.30.0.0/24
TS_OUT_SUBNET=172.30.1.0/24
BOT_OUT_SUBNET=172.30.2.0/24
