# Copy to deploy/backup.env and fill in (see docs/DEPLOYMENT_PLACEHOLDERS.md).

# Your age PUBLIC key (the line starting age1... printed by `age-keygen` on YOUR PC).
# Keep the private key off this server: it's only needed to restore.
AGE_RECIPIENT="CHANGE_ME_AGE_RECIPIENT"

# Where encrypted backups are copied with rsync, e.g. you@your-pc:/backups/proxychat/
# over Tailscale SSH or your LAN. Leave empty to keep them only on this server.
BACKUP_TARGET=""

# How many nightly backups to keep here
KEEP=14
