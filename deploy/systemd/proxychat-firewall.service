# Keeps the Proxy Chat containers off the LAN; re-applied whenever Docker restarts.
# Install: sudo cp deploy/systemd/proxychat-* /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now proxychat-firewall.service
[Unit]
Description=Proxy Chat container egress firewall (DOCKER-USER)
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/proxychat/deploy/firewall-docker-user.sh

[Install]
WantedBy=docker.service
